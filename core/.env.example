# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL por defecto, usar sqlite para pruebas rápidas)
DB_ENGINE=postgresql
DB_NAME=api_sunat
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS S3 Storage (Opcional en desarrollo, usar en producción)
USE_S3=TRUE
AWS_STORAGE_BUCKET_NAME=nombre-de-tu-bucket-s3
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_AUTH=True
# Opcionales si se usa un IAM Role en EC2 (recomendado):
AWS_ACCESS_KEY_ID=tu-access-key-id
AWS_SECRET_ACCESS_KEY=tu-secret-access-key
